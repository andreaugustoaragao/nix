+/// Loads installed faces for the requested app slots once per text system.
+pub(super) fn load_requested(collection: &mut Collection, loaded: &mut LoadedFiles, list: &str) {
+    #[cfg(all(unix, not(target_vendor = "apple"), not(target_os = "android")))]
+    for family in FontFamilyName::parse_css_list(list).flatten() {
+        let FontFamilyName::Named(name) = family else { continue };
+        if collection.family_id(&name).is_some() { continue; }
+        let mut paths: std::collections::BTreeSet<std::path::PathBuf> = font_files().iter()
+            .filter(|(_, _, families)| families.iter().any(|family| family.eq_ignore_ascii_case(name.as_ref())))
+            .map(|(_, path, _)| path.clone()).collect();
+        if paths.is_empty() {
+            let Ok(output) = std::process::Command::new("fc-list")
+                .arg("--format=%{file}\n").arg(name.as_ref()).output() else { continue };
+            if !output.status.success() { continue; }
+            paths.extend(String::from_utf8_lossy(&output.stdout)
+                .lines().filter(|path| !path.is_empty()).map(std::path::PathBuf::from));
+        }
+        load_files(collection, loaded, paths);
+    }
+    #[cfg(not(all(unix, not(target_vendor = "apple"), not(target_os = "android"))))]
+    let _ = (collection, loaded, list);
+}
