+// GLES 3.0 has no unpackHalf2x16. Preserve the packed half-float clip ABI.
+fn rune_unpack_half(h: u32) -> f32 {
+    let sign = (h & 0x8000u) << 16u;
+    let exponent = (h >> 10u) & 31u;
+    let mantissa = h & 1023u;
+    if exponent == 0u {
+        return bitcast<f32>(sign | bitcast<u32>(f32(mantissa) * 0.000000059604644775390625));
+    }
+    let exponent32 = select(exponent + 112u, 255u, exponent == 31u);
+    return bitcast<f32>(sign | (exponent32 << 23u) | (mantissa << 13u));
+}
+fn rune_unpack2x16float(value: u32) -> vec2<f32> {
+    return vec2<f32>(rune_unpack_half(value & 65535u), rune_unpack_half(value >> 16u));
+}
