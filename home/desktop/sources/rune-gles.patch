 /// to the shader source.
 pub const CLIP_WGSL: &str = include_str!("clip.wgsl");
 
+pub(crate) fn gles_wgsl<'a>(device: &wgpu::Device, source: &'a str) -> std::borrow::Cow<'a, str> {
+    if device.adapter_info().backend != wgpu::Backend::Gl {
+        return source.into();
+    }
+    let mut source = source.replace("unpack2x16float(", "rune_unpack2x16float(");
+    // Virtual GL drivers can report fragment positions relative to the wrong drawable.
+    if source.contains("i.pos.xy") {
+        source = source
+            .replace("@location(8) @interpolate(flat) fade: vec4<u32>,",
+                "@location(8) @interpolate(flat) fade: vec4<u32>,\n    @location(9) screen: vec2<f32>,")
+            .replace("o.p = p;", "o.p = p;\n    o.screen = screen;")
+            .replace("i.pos.xy", "(floor(i.screen - projection.xy) + vec2<f32>(0.5))");
+    }
+    format!("{source}\n{}", include_str!("clip_gles.wgsl")).into()
+}
+
+fn gles_kind_wgsl(source: &str) -> String {
+    let entry = "fn fs(i: Out) -> @location(0) vec4<f32> {";
+    let body = source.find(entry).expect("uber fragment entry") + entry.len();
+    let mut depth = 1;
+    let end = source[body..].char_indices().find_map(|(offset, ch)| {
+        match ch {
+            '{' => depth += 1,
+            '}' => depth -= 1,
+            _ => {}
+        }
+        (depth == 0).then_some(body + offset)
+    }).expect("uber fragment close");
+    let original = &source[body..end];
+    assert_eq!(original.matches("i.params.y").count(), 2);
+    let mut source = source.to_owned();
+    source.replace_range(body..end, &original.replace("i.params.y", "rune_fragment_kind"));
+    source.insert_str(0, "override rune_fragment_kind: f32 = 0.0;\n");
+    source
+}
