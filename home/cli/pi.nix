{
  config,
  lib,
  pkgs,
  personalOnly,
  ...
}:

let
  # Single-binary Rust toolbox of high-performance, context-aware primitives
  # invoked by pi extensions. Subcommands: hash, grep, summary, html2md,
  # ast-grep, ast-edit. Vendored from oh-my-pi (MIT, Can Boluk) under
  # home/cli/pi-rs/ and evolved independently. Builds natively on
  # x86_64-linux, aarch64-linux, and aarch64-darwin.
  piRs = pkgs.callPackage ../../home/cli/pi-rs { };
  browserTask = pkgs.callPackage ../../pkgs/browser-task.nix { };

  # Directory-style pi extension that forks oh-my-pi's 78 site-specific
  # web_fetch handlers (arxiv, github, npm, pypi, crates.io, docs.rs, mdn,
  # stackoverflow, hackernews, wikipedia, …). Builds a deterministic
  # node_modules tree (linkedom) via buildNpmPackage. The compat layer
  # under ./pi-extensions/web-fetch/compat/ remaps the omp internal
  # surface onto local primitives, including spawning `pi-rs html2md` in
  # place of bundling turndown.
  webFetchOmpExtension = pkgs.callPackage ./pi-extensions/web-fetch { };

  # Directory-style pi extension that forks oh-my-pi's multi-provider
  # web_search chain. Active providers: Anthropic (api-key, restored
  # locally) + Tavily, Perplexity, Brave, Jina, Kimi, Z.AI, Kagi,
  # Synthetic, SearXNG. Gemini, Codex, Exa-MCP, and Parallel remain
  # disabled — they need pi-ai OAuth vendoring.
  webSearchOmpExtension = pkgs.callPackage ./pi-extensions/web-search { };

  # NOTE: The legacy single-file `web_search` (ddgr-backed) and
  # `web_fetch` (trafilatura-backed) extensions used to live here. They
  # were retired once the directory-style forks of oh-my-pi's versions
  # took over those canonical names: ddgr was reliably CAPTCHA-blocked
  # by DuckDuckGo, and the trafilatura path had intermittent
  # ECONNRESETs on github.com. Both omp versions handle those cases.

  # Pi extension: `context7` tool. Wraps the Context7 REST API to fetch
  # up-to-date, version-specific library documentation and code examples.
  #
  # Uses two endpoints:
  #   1. https://context7.com/api/v2/libs/search — search by name + query
  #   2. https://context7.com/api/v2/context     — get docs for a library
  #
  # API key is optional (read from CONTEXT7_API_KEY env var). Works
  # without it at lower rate limits, same as the Claude Code plugin.
  context7Extension = pkgs.writeText "context7.ts" ''
    /**
     * Pi extension: `context7` tool for library documentation lookup.
     *
     * Generated by home/cli/pi.nix. Do not edit the deployed file directly;
     * edit the Nix source and rebuild.
     *
     * Wraps the Context7 REST API (https://context7.com/api/v2).
     * API key is optional — falls back to rate-limited unauthenticated access.
     */
    import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
    import { Type } from "typebox";
    import { StringEnum } from "@earendil-works/pi-ai";

    const BASE_URL = "https://context7.com/api/v2";
    const DEFAULT_TIMEOUT_MS = 30000;

    const apiKey = process.env.CONTEXT7_API_KEY ?? "";
    const authHeader = apiKey ? { "Authorization": "Bearer " + apiKey } : {};

    interface SearchResult {
      id: string;
      title: string;
      description: string;
      branch: string;
      lastUpdateDate: string;
      state: string;
      totalTokens: number;
      totalSnippets: number;
      stars: number;
      trustScore: number;
      benchmarkScore: number;
      versions?: string[];
    }

    interface SearchResponse {
      results: SearchResult[];
      searchFilterApplied: boolean;
    }

    interface CodeSnippet {
      codeTitle: string;
      codeDescription: string;
      codeLanguage: string;
      codeTokens: number;
      codeId: string;
      pageTitle: string;
      codeList: Array<{
        language: string;
        code: string;
      }>;
    }

    interface InfoSnippet {
      pageId: string;
      breadcrumb: string;
      content: string;
      contentTokens: number;
    }

    interface ContextResponse {
      codeSnippets: CodeSnippet[];
      infoSnippets: InfoSnippet[];
    }

    async function context7Fetch<T>(
      path: string,
      signal: AbortSignal | undefined,
    ): Promise<T> {
      const url = BASE_URL + path;
      const res = await fetch(url, {
        headers: { ...authHeader, "Content-Type": "application/json" },
        signal,
      });
      if (!res.ok) {
        const text = await res.text().catch(() => "");
        throw new Error(
          "Context7 API " + res.status + ": " + text.slice(0, 500),
        );
      }
      return res.json();
    }

    function formatSearchResults(res: SearchResponse): string {
      if (!res.results || res.results.length === 0) {
        return "No libraries found matching your query.";
      }
      const lines = res.results.slice(0, 10).map((r, i) => {
        const ver = r.versions && r.versions.length > 0
          ? " (" + r.versions.slice(0, 3).join(", ") + "...)"
          : "";
        return (
          (i + 1) + ". " + r.title + " (" + r.id + ")" + ver + "\n" +
          "   " + r.description + "\n" +
          "   stars: " + r.stars + "  trust: " + r.trustScore +
          "  snippets: " + r.totalSnippets
        );
      });
      return "Found " + res.results.length + " libraries:\n\n" + lines.join("\n\n");
    }

    function formatContextResponse(res: ContextResponse): string {
      const parts: string[] = [];

      if (res.infoSnippets && res.infoSnippets.length > 0) {
        const info = res.infoSnippets.slice(0, 10).map((s) => {
          const content = s.content.length > 2000
            ? s.content.slice(0, 2000) + "... (truncated)"
            : s.content;
          return "---\n" + s.breadcrumb + "\n\n" + content;
        });
        parts.push("## Information\n" + info.join("\n"));
      }

      if (res.codeSnippets && res.codeSnippets.length > 0) {
        const code = res.codeSnippets.map((s) => {
          const codeBlock = s.codeList.map((c) =>
            "```" + c.language + "\n" + c.code + "\n```"
          ).join("\n\n");
          return "## " + s.codeTitle + " (" + s.pageTitle + ")\n" +
            (s.codeDescription ? s.codeDescription + "\n\n" : "") +
            codeBlock +
            "\nSource: " + s.codeId;
        });
        parts.push("## Code Examples\n" + code.join("\n\n"));
      }

      if (parts.length === 0) {
        return "No documentation found for this query.";
      }

      return parts.join("\n\n") + "\n";
    }

    export default function (pi: ExtensionAPI) {
      pi.registerTool({
        name: "context7",
        label: "Context7 Documentation",
        description:
          "Fetch up-to-date, version-specific library documentation and " +
          "code examples from Context7. Solves the problem of AI assistants " +
          "relying on outdated training data by fetching real-time docs from " +
          "the source. Two-step workflow: first search for the library " +
          "(resolve-library-id), then query its documentation (query-docs). " +
          "Use even when you think you know the answer — training data may " +
          "not reflect recent changes.",
        parameters: Type.Object({
          tool: StringEnum(
            ["resolve-library-id", "query-docs"] as const,
            {
              description:
                'Tool to call: "resolve-library-id" (search) or "query-docs" (fetch docs).',
            },
          ),
          libraryName: Type.Optional(Type.String({
            description:
              "Library name to search (e.g. \"Next.js\", \"React\", \"Prisma\"). " +
              "Used with resolve-library-id. If omitted, `query` is used " +
              "as the library name and a relevance-only search runs.",
          })),
          query: Type.String({
            description:
              "Query for relevance ranking. For resolve-library-id: describe " +
              "what you want to do with the library (also doubles as the " +
              "library name when libraryName is omitted). For query-docs: " +
              "your specific question about the library.",
          }),
          libraryId: Type.Optional(Type.String({
            description:
              "Library ID from resolve-library-id results (e.g. " +
              '"/vercel/next.js"). Required for query-docs.',
          })),
          maxResults: Type.Optional(Type.Integer({
            description:
              "Maximum results to return (default 10).",
            minimum: 1,
            maximum: 50,
          })),
        }),
        async execute(_toolCallId, params, signal, _onUpdate, _ctx) {
          const timeoutCtl = new AbortController();
          const timeoutId = setTimeout(
            () => timeoutCtl.abort(),
            DEFAULT_TIMEOUT_MS,
          );
          const combinedSignal = signal
            ? AbortSignal.any([signal, timeoutCtl.signal])
            : timeoutCtl.signal;

          try {
            if (params.tool === "resolve-library-id") {
              // Fall back to `query` as the library name when libraryName
              // is omitted — the most common model-side mistake is to skip
              // libraryName and put everything in query, since omp/Context7
              // documents this as a single search call.
              const libraryName = params.libraryName ?? params.query;
              if (!libraryName) {
                return {
                  content: [{
                    type: "text",
                    text: "Error: provide `libraryName` or `query` to search for. " +
                      "Example: libraryName='React', query='How to use useEffect'.",
                  }],
                  details: { tool: params.tool, error: "missing_library_name" },
                };
              }
              const maxResults = params.maxResults ?? 10;
              const path =
                "/libs/search?libraryName=" +
                encodeURIComponent(libraryName) +
                "&query=" +
                encodeURIComponent(params.query) +
                "&maxResults=" + maxResults;

              let data: SearchResponse;
              try {
                data = await context7Fetch<SearchResponse>(path, combinedSignal);
              } catch (err: unknown) {
                const msg = err instanceof Error ? err.message : String(err);
                if (msg.includes("401") || msg.includes("403")) {
                  return {
                    content: [{
                      type: "text",
                      text: "Context7 API returned 401/403. The API may require " +
                        "a free API key. Set CONTEXT7_API_KEY in your environment " +
                        "(get one at https://context7.com/dashboard, it\'s free). " +
                        "\n\nError: " + msg,
                    }],
                    details: { tool: params.tool, error: "auth_required" },
                  };
                }
                return {
                  content: [{
                    type: "text",
                    text: "Context7 search failed: " + msg,
                  }],
                  details: { tool: params.tool, error: "api_error", message: msg },
                };
              }

              return {
                content: [{ type: "text", text: formatSearchResults(data) }],
                details: {
                  tool: "resolve-library-id",
                  libraryName,
                  query: params.query,
                  count: data.results?.length ?? 0,
                },
              };
            } else if (params.tool === "query-docs") {
              const libraryId = params.libraryId;
              if (!libraryId) {
                return {
                  content: [{
                    type: "text",
                    text: "Error: libraryId is required for query-docs. " +
                      "First use resolve-library-id to find the library, then " +
                      "pass its ID here. Example: libraryId='/vercel/next.js'.",
                  }],
                  details: { tool: params.tool, error: "missing_library_id" },
                };
              }
              const path =
                "/context?libraryId=" +
                encodeURIComponent(libraryId) +
                "&query=" +
                encodeURIComponent(params.query) +
                "&type=json";

              let data: ContextResponse;
              try {
                data = await context7Fetch<ContextResponse>(path, combinedSignal);
              } catch (err: unknown) {
                const msg = err instanceof Error ? err.message : String(err);
                if (msg.includes("401") || msg.includes("403")) {
                  return {
                    content: [{
                      type: "text",
                      text: "Context7 API returned 401/403. The API may require " +
                        "a free API key. Set CONTEXT7_API_KEY in your environment " +
                        "(get one at https://context7.com/dashboard, it\'s free). " +
                        "\n\nError: " + msg,
                    }],
                    details: { tool: params.tool, error: "auth_required" },
                  };
                }
                return {
                  content: [{
                    type: "text",
                    text: "Context7 docs lookup failed: " + msg,
                  }],
                  details: { tool: params.tool, error: "api_error", message: msg },
                };
              }

              return {
                content: [{ type: "text", text: formatContextResponse(data) }],
                details: {
                  tool: "query-docs",
                  libraryId: libraryId,
                  query: params.query,
                  snippets: data.codeSnippets?.length ?? 0,
                  info: data.infoSnippets?.length ?? 0,
                },
              };
            } else {
              return {
                content: [{
                  type: "text",
                  text: "Unknown tool: " + params.tool,
                }],
                details: { tool: params.tool, error: "unknown_tool" },
              };
            }
          } finally {
            clearTimeout(timeoutId);
          }
        },
      });
    }
  '';

  # Pi extension: single `lsp` tool exposing 14 actions across LSP
  # (diagnostics, hover, definition / type_definition / implementation,
  # references, document & workspace symbols, code_actions, rename,
  # rename_file, status, reload, capabilities, raw request). Language
  # server binaries are substituted from Nix store paths at build time.
  lspExtension = pkgs.writeText "lsp.ts" (
    builtins.replaceStrings
      [ "___GOLANG_LSP___" "___TS_LSP___" "___RUST_ANALYZER___" "___NIX_LSP___" ]
      [
        "${pkgs.gopls}/bin/gopls"
        "${pkgs.typescript-language-server}/bin/typescript-language-server"
        "${pkgs.rust-analyzer}/bin/rust-analyzer"
        "${pkgs.nil}/bin/nil"
      ]
      (builtins.readFile ./lsp-extension.ts)
  );

  # Pi extension: `ast_grep` tool. Backed by `pi-rs ast-grep` (in-tree
  # tree-sitter via the pi-ast crate). Replaces the previous wrapper
  # around the standalone `sg` binary; gives meta-variable capture,
  # parse-error collection, and pagination matching omp's surface.
  astGrepExtension = pkgs.writeText "ast-grep.ts" (
    builtins.replaceStrings [ "___PI_RS_BIN___" ] [ "${piRs}/bin/pi-rs" ] (
      builtins.readFile ./ast-grep-extension.ts
    )
  );

  # Pi extension: `ast_edit` tool. Backed by `pi-rs ast-edit`. Previews
  # rewrites by default; writes to disk when called with `apply: true`.
  astEditExtension = pkgs.writeText "ast-edit.ts" (
    builtins.replaceStrings [ "___PI_RS_BIN___" ] [ "${piRs}/bin/pi-rs" ] (
      builtins.readFile ./ast-edit-extension.ts
    )
  );

  # Pi extension: bash-command rewrite hook for pi-rs token compression.
  # Sits on the `tool_call` event; for every Bash tool invocation, calls
  # `pi-rs rewrite` and mutates `event.input.command` if a rule fires.
  # Mirror of the per-agent shims for claude/cursor/codex — same binary
  # contract, single source of truth in rewrite/rules.rs.
  #
  # The template lives in the source tree and is also copied verbatim
  # into the pi-rs derivation's share/ output for the documentation
  # surface — we read directly from the source path here to avoid an
  # import-from-derivation that would force pi-rs to build during eval
  # (which breaks cross-arch `nix flake check`).
  piRsRewriteExtension = pkgs.writeText "pi-rs-rewrite.ts" (
    builtins.replaceStrings [ "___PI_RS_BIN___" ] [ "${piRs}/bin/pi-rs" ] (
      builtins.readFile ../../home/cli/pi-rs/agent-hooks/pi-rewrite-extension.ts
    )
  );

  webBrowserMcpExtension = pkgs.writeText "browser-mcp.ts" ''
    import type { AgentToolResult, ExtensionAPI } from "@earendil-works/pi-coding-agent";
    import { Type } from "typebox";
    import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
    import { Buffer } from "node:buffer";
    import { StringDecoder } from "node:string_decoder";

    const BROWSER_TASK = "${lib.getExe browserTask}";
    const MAX_FRAME = 512000;
    const MAX_RESULT = 100000;

    type RpcReply = { id: number; result?: unknown; error?: unknown };
    type Details = { task: string; page: string; error?: string };
    type Pending = { resolve: (reply: RpcReply) => void; reject: (error: Error) => void };

    function isRecord(value: unknown): value is Record<string, unknown> {
      return typeof value === "object" && value !== null && !Array.isArray(value);
    }

    function isRpcReply(value: unknown): value is RpcReply {
      return isRecord(value) && typeof value.id === "number";
    }


    class BrowserMcp {
      private child: ChildProcessWithoutNullStreams;
      private pending = new Map<number, Pending>();
      private nextId = 3;
      private buffer = "";
      private decoder = new StringDecoder("utf8");
      private stderr = "";
      private closed = false;
      readonly ready: Promise<Record<string, unknown>>;

      get stopped(): boolean { return this.closed; }

      constructor() {
        this.child = spawn(BROWSER_TASK, ["mcp"], { stdio: ["pipe", "pipe", "pipe"] });
        this.child.stdout.on("data", (data: Buffer) => this.onData(data));
        this.child.stdin.on("error", (error: Error) => this.fail(error));
        this.child.stderr.on("data", (data: Buffer) => {
          this.stderr = (this.stderr + data.toString("utf8")).slice(-2000);
        });
        this.child.on("error", (error: Error) => this.fail(error));
        this.child.on("close", (code) => {
          this.fail(new Error("browser-task mcp exited " + code + ": " + this.stderr));
        });
        this.ready = this.request("initialize", {
          protocolVersion: "2024-11-05", capabilities: {},
          clientInfo: { name: "pi-browser-task", version: "1" },
        }, 1, 10000).then(async (init) => {
          if (init.error || !isRecord(init.result)) throw new Error("browser-task initialize failed");
          this.send({ jsonrpc: "2.0", method: "notifications/initialized" });
          const reply = await this.request("tools/list", {}, 2, 10000);
          if (reply.error) throw new Error("browser-task tools/list failed");
          const result = isRecord(reply.result) ? reply.result : {};
          const tools = Array.isArray(result.tools) ? result.tools : [];
          const browser = tools.find((item: unknown) => isRecord(item) && item.name === "dev_browser");
          if (!isRecord(browser) || !isRecord(browser.inputSchema)) {
            throw new Error("browser-task tools/list has no dev_browser schema");
          }
          return browser.inputSchema;
        });
      }

      private send(frame: Record<string, unknown>): void {
        if (this.closed) throw new Error("browser-task mcp is closed");
        this.child.stdin.write(JSON.stringify(frame) + "\n");
      }

      private onData(data: Buffer): void {
        this.buffer += this.decoder.write(data);
        if (this.buffer.length > MAX_FRAME) {
          this.fail(new Error("browser-task mcp response exceeded limit"));
          this.child.kill("SIGTERM");
          return;
        }
        let end: number;
        while ((end = this.buffer.indexOf("\n")) !== -1) {
          const line = this.buffer.slice(0, end);
          this.buffer = this.buffer.slice(end + 1);
          if (!line.trim()) continue;
          let value: unknown;
          try { value = JSON.parse(line); }
          catch { this.fail(new Error("invalid browser-task mcp response")); this.child.kill("SIGTERM"); return; }
          if (!isRpcReply(value)) continue;
          const pending = this.pending.get(value.id);
          if (!pending) continue;
          this.pending.delete(value.id);
          pending.resolve(value);
        }
      }

      private fail(error: Error): void {
        if (this.closed) return;
        this.closed = true;
        for (const pending of this.pending.values()) pending.reject(error);
        this.pending.clear();
      }

      private request(
        method: string, params: Record<string, unknown>, id: number, timeoutMs: number,
        signal?: AbortSignal,
      ): Promise<RpcReply> {
        return new Promise((resolve, reject) => {
          let settled = false;
          const finish = (error?: Error, reply?: RpcReply) => {
            if (settled) return;
            settled = true;
            clearTimeout(timer);
            signal?.removeEventListener("abort", abort);
            this.pending.delete(id);
            if (error) reject(error);
            else if (reply) resolve(reply);
          };
          const cancel = (reason: string) => {
            try {
              this.send({ jsonrpc: "2.0", method: "notifications/cancelled", params: { requestId: id, reason } });
            } catch {}
            finish(new Error(reason));
          };
          const abort = () => cancel("browser action cancelled");
          const timer = setTimeout(() => cancel("browser action timed out"), timeoutMs);
          this.pending.set(id, {
            resolve: (reply) => finish(undefined, reply),
            reject: (error) => finish(error),
          });
          signal?.addEventListener("abort", abort, { once: true });
          if (signal?.aborted) { abort(); return; }
          try { this.send({ jsonrpc: "2.0", id, method, params }); }
          catch (error) { finish(error instanceof Error ? error : new Error(String(error))); }
        });
      }

      async action(args: Record<string, unknown>, timeout: number, signal?: AbortSignal): Promise<string> {
        await this.ready;
        const id = this.nextId++;
        const reply = await this.request("tools/call", { name: "dev_browser", arguments: args }, id, (timeout + 5) * 1000, signal);
        if (reply.error) throw new Error(isRecord(reply.error) && typeof reply.error.message === "string" ? reply.error.message : "browser-task mcp error");
        const result = isRecord(reply.result) ? reply.result : {};
        const content = Array.isArray(result.content) ? result.content : [];
        const text = content
          .filter((item: unknown): item is { type: "text"; text: string } =>
            isRecord(item) && item.type === "text" && typeof item.text === "string")
          .map((item) => item.text)
          .join("\n");
        if (result.isError === true) throw new Error(text || "browser action failed");
        return text.slice(0, MAX_RESULT) + (text.length > MAX_RESULT ? "\n[output truncated]" : "");
      }

      shutdown(): void {
        if (this.closed) return;
        for (const id of this.pending.keys()) {
          this.send({ jsonrpc: "2.0", method: "notifications/cancelled", params: { requestId: id, reason: "Pi session ended" } });
        }
        this.fail(new Error("Pi session ended"));
        this.child.stdin.end();
        const timer = setTimeout(() => this.child.kill("SIGKILL"), 2000);
        timer.unref();
      }
    }

    export default async function (pi: ExtensionAPI) {
      let client: BrowserMcp | undefined = new BrowserMcp();
      pi.on("session_shutdown", () => { client?.shutdown(); client = undefined; });
      let schema: Record<string, unknown>;
      try { schema = await client.ready; }
      catch (error) { client.shutdown(); throw error; }
      pi.registerTool({
        name: "dev_browser",
        label: "Browser task",
        description: "Run one typed action on an owned browser-task page. Start a task with browser-task first. Use snapshot refs or unique role and name targets. Evaluate accepts only a synchronous page-local expression. No persistent console or network event API.",
        parameters: Type.Unsafe<{ task: string; action: Record<string, unknown>; page?: string; timeout?: number }>(schema),
        async execute(_toolCallId, params, signal): Promise<AgentToolResult<Details>> {
          const page = params.page ?? "main";
          try {
            if (!client || client.stopped) client = new BrowserMcp();
            const result = await client.action({
              task: params.task, action: params.action,
              page, timeout: params.timeout ?? 30,
            }, params.timeout ?? 30, signal);
            return { content: [{ type: "text", text: result }], details: { task: params.task, page } };
          } catch (error) {
            const message = error instanceof Error ? error.message : String(error);
            return { content: [{ type: "text", text: "browser action failed: " + message }], details: { task: params.task, page, error: message } };
          }
        },
      });
    }
  '';
in
{
  # Pi auto-discovers single-file extensions in this directory.
  # See: ~/.npm-global/lib/node_modules/@earendil-works/pi-coding-agent/README.md
  # (Customization → Extensions).
  # Install pi-rs into the user environment so the TS extensions can
  # spawn `pi-rs <subcommand>` without baking a per-host store path. Same
  # binary, three triples (x86_64-linux, aarch64-linux, aarch64-darwin).
  # piRs backs the code-* extensions; mcp-nixos is spawned per call by
  # the `nixos` bridge extension (and is the same binary Claude Code
  # registers over stdio via `claude mcp add`).
  home.packages = [
    piRs
    browserTask
    pkgs.mcp-nixos
  ];

  # Pi has no built-in vim mode; @burneikis/pi-vim replaces the composer
  # with a vim-modal editor. Seed the package into settings.json so pi
  # auto-loads it on startup.
  home.activation.piVimMode = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    target="${config.home.homeDirectory}/.pi/agent/settings.json"
    mkdir -p "$(dirname "$target")"
    pkg="npm:@burneikis/pi-vim"
    if [[ -f "$target" ]]; then
      existing="$(cat "$target")"
    else
      existing='{}'
    fi
    printf '%s' "$existing" \
      | ${pkgs.jq}/bin/jq --arg pkg "$pkg" '
          .packages = ((.packages // []) + [$pkg] | unique)
        ' \
      > "$target.tmp"
    mv "$target.tmp" "$target"
    chmod 0600 "$target"
  '';

  home.file.".pi/agent/extensions/context7.ts".source = context7Extension;
  home.file.".pi/agent/extensions/lsp.ts".source = lspExtension;
  home.file.".pi/agent/extensions/ast-grep.ts".source = astGrepExtension;
  home.file.".pi/agent/extensions/ast-edit.ts".source = astEditExtension;
  home.file.".pi/agent/extensions/browser-mcp.ts".source = webBrowserMcpExtension;
  home.file.".pi/agent/extensions/pi-rs-rewrite.ts".source = piRsRewriteExtension;

  # pi-rs-backed primitives. These are thin TS shells that spawn the
  # `pi-rs <subcommand>` binary installed via `home.packages` above.
  home.file.".pi/agent/extensions/code-search.ts".source = ./pi-extensions/code-search.ts;
  home.file.".pi/agent/extensions/code-summary.ts".source = ./pi-extensions/code-summary.ts;
  home.file.".pi/agent/extensions/code-hash.ts".source = ./pi-extensions/code-hash.ts;

  # MCP bridge: pi has no native MCP client, so this `nixos` tool spawns
  # the mcp-nixos server (home.packages) over stdio per call. Claude Code
  # talks to the same binary directly; this exists only because pi can't.
  home.file.".pi/agent/extensions/mcp-nixos.ts".source = ./pi-extensions/mcp-nixos.ts;

  # Directory-style `web_fetch` and `web_search` extensions, both forked
  # from oh-my-pi. They register the canonical tool names; the older
  # single-file ddgr+trafilatura versions were retired in favor of these.
  home.file.".pi/agent/extensions/web-fetch".source = webFetchOmpExtension;
  home.file.".pi/agent/extensions/web-search".source = webSearchOmpExtension;

  # Master cycle list for Ctrl+P / Shift+Ctrl+P. Seeded into
  # ~/.pi/agent/settings.json -> enabledModels by
  # home/services/pi-models.nix on the first activation that finds
  # the field unset. After that, pi's /scoped-models interactive UI
  # owns the field — including any per-model thinking-level overrides
  # (xhigh for Opus, off for the local Qwen, etc.).
  #
  # Provider/id qualification is mandatory here: `claude-opus-4-7`
  # exists both as a built-in Anthropic model AND as a route on the
  # corporate LiteLLM gateway, so we have to be explicit about which
  # path each cycle slot takes. Anthropic models go direct via
  # ANTHROPIC_API_KEY (fish-exported from /run/secrets); the four GPT
  # and Gemini entries route through litellm. The local wildcard selects
  # Qwen3.6 on the workstation and Bonsai 2 on VM hosts that use mac-work.
  services.piModels.enabledModels = [
    "anthropic/claude-opus-4-7"
  ]
  ++ lib.optionals (!personalOnly) [
    "litellm/gpt-5.5"
    "litellm/gpt-5.4"
    "litellm/gemini-2.5-pro"
    "litellm/gemini-2.5-flash"
    "llama-cpp/*-local"
  ];

  # Global pi context file. Loaded into every pi session's system prompt.
  # See: pi-coding-agent/README.md (Context Files).
  home.file.".pi/agent/AGENTS.md".text = ''
    Never estimate time, hours, effort, or duration. If asked, refuse and
    offer concrete scope instead (files touched, comparable prior work,
    decision points, unknowns).
  ''
  + import ./browser-instructions.nix;

  # Pi skill: exploratory testing with the managed development browser.
  home.file.".pi/agent/skills/explore-frontend/SKILL.md".text = ''
    ---
    name: explore-frontend
    description: |
      Explore and stress-test a frontend in the managed development browser.
      Trigger phrases include "explore the UI", "chaos test", "bug hunt the UI",
      "smoke test the UI", and "post-deploy UX verification".
    ---

    # Explore frontend

    Act as a curious, adversarial user. Exercise every reachable path and
    record defects with reproducible steps and evidence. Ask for the target
    URL if neither the request nor project context identifies it.

    ## Start the task

    Run `browser-task start development --label "Frontend exploration"`
    and retain its UUID as `TASK`. Use `browser-task open TASK --page explore
    --url URL` for a named page, or start with `--url URL` and use `main`.
    Every `dev_browser` call takes that UUID, an `action`, the page name,
    and optional `timeout` in seconds. If the managed browser is unavailable,
    report its error. Do not attach to an everyday browser or install one.

    ## Map the app

    Call `dev_browser` with `{"task":"TASK","page":"explore","action":{"type":"snapshot"}}`.
    Record the visible links, forms, buttons, navigation, and page regions
    in a checklist. To visit another route, use a `navigate` action with its
    full URL or click a unique link target from the snapshot. Take a fresh
    snapshot after every navigation or state change. A new snapshot or
    navigation invalidates older refs.

    Use `evaluate` for synchronous page-local reads, such as
    `{"type":"evaluate","expression":"({url:location.href,title:document.title})"}`.
    The expression returns its value and has no host bindings or Promise
    support. Page globals remain until navigation. The native tool has no persistent console
    or network event listeners. Record that coverage limit in the report.

    ## Stress each path

    For each view, use one typed action at a time and inspect the result.
    Use `click` or `fill` with a snapshot ref or a unique accessible role
    and name. For example,
    `{"type":"click","target":{"role":"button","name":"Save"}}`.
    Use `key` for Enter, Tab, Escape, and browser shortcuts. Use `wait`
    for a visible or hidden target when the UI changes asynchronously.
    Use `viewport` to check narrow and wide layouts. A `screenshot` action
    returns a private artifact path to cite in findings.

    Test links, deep URLs, validation, empty and long inputs, double submits,
    destructive confirmation, unexpected action order, navigation during a
    flow, empty states, and keyboard access when the app permits them. Try
    adversarial text such as long strings, markup, unicode, negative values,
    and invalid dates. Never assume a mutation is safe in a real account.
    Open another owned page with `browser-task open TASK --page explore-tab2
    --url URL` to compare state across tabs. Do not select tabs through CDP.

    After each interaction, call `snapshot`. Capture a screenshot for a
    visible failure. Record the URL with a synchronous `evaluate` expression
    when needed. If an action fails, inspect the current state before a retry.
    Do not use `evaluate` to synthesize input or navigation. The native API
    has no network request interception, so mark network disruption tests
    as untested unless another authorized app-level method exists.

    A finding needs a user-visible failure and evidence. Record crashes,
    broken UI, missing validation, lost input, dead controls, bad navigation,
    missing feedback, duplicate mutations, and keyboard traps. Do not report
    styling preferences, missing features, or unsupported guesses as defects.

    ## Report

    Write findings to the project's existing bug location. If there is no
    convention, write `EXPLORATION-FINDINGS.md` in the working directory.
    For each finding include severity, URL, steps, expected and actual
    results, screenshot path, and a suggested fix when clear. Use critical
    for crashes, data loss, or security defects. Use high for a broken core
    flow, medium for partial loss or confusing recovery, and low for minor
    visual defects. Summarize paths and interactions tested. List untested
    console, network, or interception checks explicitly.

    Finish with `browser-task finish TASK` when the work is complete. Use
    `keep` for login or user review and `show` only on user request. Run
    `resume` before further automation of a kept or completed task.
  '';

  # Pi skill: typed actions on a task-owned browser page.
  home.file.".pi/agent/skills/dev-browser/SKILL.md".text = ''
    ---
    name: dev-browser
    description: |
      Use the native dev_browser tool to test or inspect a frontend in a
      managed browser, especially a local development server.
    ---

    # dev_browser

    Start with `browser-task start development --label "Frontend test"
    --url URL` and retain the returned UUID. Use `accounts` for signed-in
    services. Send `dev_browser` one typed action at a time with `task`,
    optional `page` (default `main`), and optional `timeout` (1 to 300
    seconds, default 30). Use `browser-task open TASK --page NAME [--url URL]`
    to create another owned page. The tool schema defines the full action
    arguments; `browser-task schema` prints the tool request schema.

    ## Common actions

    - Inspect the page with `{"type":"snapshot"}`. It returns text and
      opaque refs for live elements.
    - Navigate with `{"type":"navigate","url":"http://localhost:3000"}`.
    - Click with `{"type":"click","target":{"role":"button","name":"Login"}}`
      or a `{"ref":"..."}` target copied from a fresh snapshot.
    - Fill with `{"type":"fill","target":{"ref":"..."},"text":"alice@example.com"}`.
    - Press a key with `{"type":"key","key":"Enter"}`.
    - Wait with `{"type":"wait","target":{"role":"heading","name":"Welcome"},"state":"visible"}`.
    - Read a value with `{"type":"evaluate","expression":"({url:location.href,title:document.title})"}`.
    - Capture a private PNG artifact with `{"type":"screenshot","full_page":true}`.

    A role and name must identify one live accessible element. `click` and
    `fill` use trusted browser input and reject obscured or stale targets.
    Take a new snapshot after navigation or page changes. A new snapshot
    or navigation invalidates earlier refs. Inspect state before retrying a
    failed action. A screenshot returns a path, MIME type, and byte count.

    `evaluate` runs a synchronous expression in the owned page and returns
    its value. It has no host bindings or host filesystem API and rejects
    Promise results. Page globals remain until navigation. Use typed actions for navigation and input. There
    are no persistent console or network event APIs or request interception.

    ## Verify a login flow

    Navigate to the login URL. Take a snapshot and locate the email and
    password fields. Fill each field, then click the unique Submit button.
    Wait for the Welcome heading and inspect a fresh snapshot. On failure,
    capture a screenshot and report its returned path with the observed URL.
    Do not paste real credentials into the action arguments; use the
    managed accounts profile for user-assisted login.

    ## Task lifecycle

    `browser-task info TASK` shows ownership and state. `finish` starts
    one-hour retention when browser work is complete. Use `keep` for login
    or review, `show` only on user request, and `resume` before automation
    of a kept or completed task. If the profile is unavailable, report its
    error. Do not attach to another browser or install an unmanaged runtime.
  '';
}
