+++ b/src/core/LogindSession.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <QtCore/QString>
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusObjectPath>
+#include <QtDBus/QDBusReply>
+#include <QtDBus/QDBusVariant>
+
+// Resolve only the requested PID through the trusted system-bus logind.
+// Polkit still verifies the caller's session when registering the listener.
+inline QString logindSessionForProcess(quint32 pid) {
+    const auto bus = QDBusConnection::systemBus();
+    auto lookup = QDBusMessage::createMethodCall(
+        QStringLiteral("org.freedesktop.login1"),
+        QStringLiteral("/org/freedesktop/login1"),
+        QStringLiteral("org.freedesktop.login1.Manager"),
+        QStringLiteral("GetSessionByPID"));
+    lookup << pid;
+    const QDBusReply<QDBusObjectPath> session = bus.call(lookup, QDBus::Block, 5000);
+    if (!session.isValid())
+        return {};
+
+    auto properties = QDBusMessage::createMethodCall(
+        QStringLiteral("org.freedesktop.login1"), session.value().path(),
+        QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+    properties << QStringLiteral("org.freedesktop.login1.Session") << QStringLiteral("Id");
+    const QDBusReply<QDBusVariant> id = bus.call(properties, QDBus::Block, 5000);
+    if (!id.isValid() || id.value().variant().metaType().id() != QMetaType::QString)
+        return {};
+
+    return id.value().variant().toString();
+}
