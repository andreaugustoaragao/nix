     use super::*;
     use tokio::time::sleep;
 
+    #[tokio::test]
+    async fn test_background_tab_commands_require_explicit_activation() {
+        use futures_util::{SinkExt, StreamExt};
+        use std::sync::Mutex;
+        use tokio_tungstenite::{accept_async, tungstenite::Message};
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("ws://{}", listener.local_addr().unwrap());
+        let recorded = Arc::new(Mutex::new(Vec::<Value>::new()));
+        let server_recorded = recorded.clone();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut socket = accept_async(stream).await.unwrap();
+            while let Some(Ok(message)) = socket.next().await {
+                let Message::Text(text) = message else {
+                    continue;
+                };
+                let command: Value = serde_json::from_str(&text).unwrap();
+                server_recorded.lock().unwrap().push(command.clone());
+                let result = match command["method"].as_str().unwrap() {
+                    "Target.createTarget" => json!({ "targetId": "new-target" }),
+                    "Target.attachToTarget" => json!({ "sessionId": "new-session" }),
+                    "Runtime.evaluate" => {
+                        json!({ "result": { "type": "string", "value": "test" } })
+                    }
+                    _ => json!({}),
+                };
+                socket
+                    .send(Message::Text(
+                        json!({ "id": command["id"], "result": result }).to_string(),
+                    ))
+                    .await
+                    .unwrap();
+            }
+        });
+        let client = Arc::new(CdpClient::connect(&url).await.unwrap());
+        let mut manager = BrowserManager {
+            client,
+            browser_process: None,
+            ws_url: url,
+            pages: vec![PageInfo {
+                tab_id: 1,
+                label: None,
+                target_id: "existing-target".into(),
+                session_id: "existing-session".into(),
+                url: "about:blank".into(),
+                title: "Existing".into(),
+                target_type: "page".into(),
+            }],
+            active_page_index: 0,
+            default_timeout_ms: 25_000,
+            download_path: None,
+            ignore_https_errors: false,
+            visited_origins: HashSet::new(),
+            next_tab_id: 2,
+        };
+        let new_tab = manager
+            .tab_new(Some("https://example.test"), Some("check"))
+            .await
+            .unwrap();
+        assert_eq!(new_tab["tabId"], "t2");
+        manager.tab_switch_by_id(1).await.unwrap();
+        manager.tab_switch_by_id(2).await.unwrap();
+        assert_eq!(manager.active_tab_id(), Some(2));
+        {
+            let commands = recorded.lock().unwrap();
+            let creation = commands
+                .iter()
+                .find(|c| c["method"] == "Target.createTarget")
+                .unwrap();
+            assert_eq!(creation["params"]["background"], true);
+            assert_eq!(creation["params"]["focus"], false);
+            assert!(!commands.iter().any(|c| c["method"] == "Page.bringToFront"));
+        }
+        manager.bring_to_front().await.unwrap();
+        assert_eq!(
+            recorded
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|c| c["method"] == "Page.bringToFront")
+                .count(),
+            1
+        );
+        server.abort();
+    }
